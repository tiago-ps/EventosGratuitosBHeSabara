{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "muralcultural",
  "main": "cloudflare/social-preview-worker.js",
  "compatibility_date": "2026-09-27",
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/q/*",
      "/s/*",
      "/",
      "/index.html"
    ]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 12 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "SUGESTOES_DB",
      "database_name": "mural-sugestoes-curadoria",
      "database_id": "32bc6d5f-4750-452a-bb5e-0a90878fc15a",
      "migrations_dir": "cloudflare/migrations"
    }
  ]
}
